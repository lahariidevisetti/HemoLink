# ════════════════════════════════════════════════════════════
# HemoLink Backend Environment Configuration Example
# ════════════════════════════════════════════════════════════

# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5173
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# Database Configuration (MongoDB Atlas / Mongoose)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/hemolink?retryWrites=true&w=majority

# Brevo Transactional Email REST API Configuration
BREVO_API_KEY=
SENDER_EMAIL=your_verified_sender@domain.com
SENDER_NAME=HemoLink Blood Platform 🩸

# Cloudinary Storage Configuration (Optional)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=Hemo_Link
